{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator record with hashed security PIN and verified identity.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "displayName": { "type": "string" },
        "pinHash": { "type": "string" },
        "pinSalt": { "type": "string" },
        "isPrimaryOwner": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["uid", "email", "phone", "displayName", "pinHash", "pinSalt", "isPrimaryOwner", "createdAt", "updatedAt"]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Central store settings, delivery fees, payment configuration, APK release metadata, and policies.",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "shopTagline": { "type": "string" },
        "supportWhatsapp": { "type": "string" },
        "supportEmail": { "type": "string" },
        "shopAddress": { "type": "string" },
        "deliveryCharge": { "type": "number" },
        "freeDeliveryAbove": { "type": "number" },
        "referralRewardAmount": { "type": "number" },
        "codEnabled": { "type": "boolean" },
        "onlinePaymentEnabled": { "type": "boolean" },
        "razorpayKeyId": { "type": "string" },
        "appVersion": { "type": "string" },
        "apkDownloadUrl": { "type": "string" },
        "apkFileSizeMb": { "type": "string" },
        "iosAppStoreUrl": { "type": "string" },
        "releaseNotes": { "type": "string" },
        "bootstrapCompleted": { "type": "boolean" },
        "privacyPolicy": { "type": "string" },
        "termsText": { "type": "string" },
        "shippingPolicy": { "type": "string" },
        "refundPolicy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["shopName", "deliveryCharge", "freeDeliveryAbove", "referralRewardAmount", "codEnabled", "onlinePaymentEnabled", "appVersion", "bootstrapCompleted", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category shown across customer storefront and admin catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "imageUrl": { "type": "string" },
        "displayOrder": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["name", "nameBn", "displayOrder", "isActive", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Central catalog product synchronized to all customers.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "brand": { "type": "string" },
        "sku": { "type": "string" },
        "mrp": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "discountPercent": { "type": "integer" },
        "stockQuantity": { "type": "integer" },
        "isPublished": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "salesCount": { "type": "integer" },
        "ratingSum": { "type": "integer" },
        "ratingCount": { "type": "integer" },
        "imageUrls": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["name", "description", "categoryId", "categoryName", "brand", "sku", "mrp", "sellingPrice", "discountPercent", "stockQuantity", "isPublished", "isFeatured", "salesCount", "ratingSum", "ratingCount", "imageUrls", "createdAt", "updatedAt"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Customer rating and review for a product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment", "createdAt", "updatedAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional banner managed by Admin.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "badgeText": { "type": "string" },
        "imageUrl": { "type": "string" },
        "targetCategory": { "type": "string" },
        "isActive": { "type": "boolean" },
        "displayOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "subtitle", "isActive", "displayOrder", "createdAt", "updatedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon code managed by Admin.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercent": { "type": "integer" },
        "maxDiscountAmount": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["code", "discountPercent", "maxDiscountAmount", "minOrderAmount", "isActive", "createdAt", "updatedAt"]
    },
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Private customer profile, referral info, and preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "referralCode": { "type": "string" },
        "referredByCode": { "type": "string" },
        "referralRewardEarned": { "type": "number" },
        "isBlocked": { "type": "boolean" },
        "preferredLanguage": { "type": "string", "enum": ["en", "bn"] },
        "darkMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "name", "email", "referralCode", "referralRewardEarned", "isBlocked", "preferredLanguage", "darkMode", "createdAt", "updatedAt"]
    },
    "DeliveryAddress": {
      "title": "DeliveryAddress",
      "description": "Saved customer delivery address.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "recipientName": { "type": "string" },
        "phone": { "type": "string" },
        "line1": { "type": "string" },
        "line2": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "label", "recipientName", "phone", "line1", "city", "state", "pincode", "isDefault", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Persistent shopping cart item.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "quantity": { "type": "integer" },
        "addedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "productId", "quantity", "addedAt", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Customer saved wishlist item.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "productId", "addedAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Order, product, and referral notifications.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "referenceId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "title", "message", "type", "isRead", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with payment and live tracking fields.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "shippingAddressLine": { "type": "string" },
        "shippingCity": { "type": "string" },
        "shippingState": { "type": "string" },
        "shippingPincode": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "couponCode": { "type": "string" },
        "deliveryCharge": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["COD", "ONLINE"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PAID", "FAILED", "REFUNDED"] },
        "transactionId": { "type": "string" },
        "orderStatus": {
          "type": "string",
          "enum": ["PENDING", "CONFIRMED", "PROCESSING", "PACKED", "SHIPPED", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED", "RETURN_REQUESTED", "REFUNDED"]
        },
        "trackingCarrier": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "trackingNote": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "customerName", "customerEmail", "customerPhone", "shippingAddressLine", "shippingCity", "shippingState", "shippingPincode", "items", "subtotal", "discountAmount", "deliveryCharge", "totalAmount", "paymentMethod", "paymentStatus", "orderStatus", "idempotencyKey", "createdAt", "updatedAt"]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Tracked referral attribution and reward record.",
      "type": "object",
      "properties": {
        "referrerUid": { "type": "string" },
        "referrerCode": { "type": "string" },
        "referredUid": { "type": "string" },
        "referredEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["REGISTERED", "REWARDED"] },
        "rewardAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["referrerUid", "referrerCode", "referredUid", "referredEmail", "status", "rewardAmount", "createdAt", "updatedAt"]
    },
    "ReferralCodeLookup": {
      "title": "ReferralCodeLookup",
      "description": "Public code-to-UID lookup for referral attribution.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["code", "ownerUid", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin identities."
    },
    "/store_config/{configId}": {
      "schema": { "$ref": "#/entities/StoreConfig" },
      "description": "Central store configuration."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Central product catalog."
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Product customer reviews."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Promotional storefront banners."
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Discount coupons."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/CustomerProfile" },
      "description": "Private customer profiles."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/DeliveryAddress" },
      "description": "Customer saved delivery addresses."
    },
    "/users/{userId}/cart/{productId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Customer persistent shopping cart."
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Customer wishlist."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User notifications."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Referral attribution records."
    },
    "/referral_codes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCodeLookup" },
      "description": "Referral code lookup."
    }
  }
}
